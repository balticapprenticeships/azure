{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.11.0.0",
    "parameters": {
        "vmPlatform": {
            "type": "string",
            "allowedValues": [
                "WindowsServer",
                "WindowsClient"
            ],
            "metadata": {
                "description": "Which lab platform to build. The UI asks this first; everything platform-specific keys off it."
            }
        },
        "hibernationEnabled": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Enable hibernation on the virtual machines. Windows client only - Windows Server does not support hibernation while Hyper-V is enabled. The portal hides the box for a server course, and windowsVm.json forces it off for WindowsServer whatever is passed in, so a CLI deployment cannot turn it on either. Hibernation has to be set when the VM is created and is only supported on certain VM sizes - see README.md. Defaults to false."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location to store all VM resources."
            }
        },
        "vmName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 8,
            "metadata": {
                "description": "Virtual Machine name, 3 to 8 letters and numbers, e.g., 306Clnt. With the coach initials, a 3 character uniqueness suffix and the machine number this has to fit the 15 character Windows host name limit: 8 + 2 + 3 + 2 = 15."
            }
        },
        "vmSize": {
            "type": "string",
            "allowedValues": [
                "Standard_B1ms",
                "Standard_B2s",
                "Standard_D2s_v3",
                "Standard_D4s_v3",
                "Standard_D2s_v5",
                "Standard_D4as_v5",
                "Standard_D2as_v5",
                "Standard_B2ms",
                "Standard_B4ms",
                "Standard_D4s_v5",
                "Standard_E2s_v3",
                "Standard_NV4as_v4",
                "Standard_NV12s_v3",
                "Standard_NC4as_T4_v3"
            ],
            "metadata": {
                "description": "Virtual Machine size e.g., 2vCPU's 4GB RAM"
            }
        },
        "vmCount": {
            "type": "int",
            "minValue": 1,
            "maxValue": 20,
            "metadata": {
                "description": "The number of Virtual Machines required between 1 and 20"
            }
        },
        "osDiskType": {
            "type": "string",
            "defaultValue": "StandardSSD_LRS",
            "allowedValues": [
                "Standard_LRS",
                "StandardSSD_LRS"
            ],
            "metadata": {
                "description": "Select the type of storage Standard HDD, SSD or Premium SSD"
            }
        },
        "osDiskDeleteOption": {
            "type": "string",
            "defaultValue": "Delete",
            "allowedValues": [
                "Delete",
                "Detach"
            ],
            "metadata": {
                "description": "Whether the OS disk is deleted or detached when the virtual machine is deleted."
            }
        },
        "osPlatform": {
            "type": "string",
            "defaultValue": "Windows",
            "allowedValues": [
                "Windows",
                "Linux"
            ],
            "metadata": {
                "description": "Operating system type. Only Windows is implemented - Linux is reserved: the networkSecurityGroup module opens SSH for it, but there is no Linux VM module, so selecting it produces a deployment with no virtual machines."
            }
        },
        "apprenticeshipProgramme": {
            "type": "string",
            "allowedValues": [
                "l3IctSupTech",
                "l3IctNetTech",
                "l4NetEng",
                "bootcamp",
                "l3Data",
                "l4Data",
                "l5Data",
                "l4SoftDev",
                "exams"
            ],
            "metadata": {
                "description": "Apprenticeship programme being delivered. Selects which course image map entry is used. Deliberately has no defaultValue - the previous default of \"noValue\" was not in allowedValues, so any deployment that did not supply it failed with a confusing error. The UI always supplies it."
            }
        },
        "l3SupTechCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "ICTSupC2",
                "ICTSupC3",
                "ICTSupC4",
                "ICTSupC6",
                "ICTSupMstr"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "l3NetTechCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "ICTNetC2",
                "ICTNetC3",
                "ICTNetC5",
                "ICTNetC6",
                "ICTNetEPA"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "l4NetEngCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "L4NetEngC4",
                "L4NetEngC5",
                "L4NetEngC7"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "bootcampCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "ItBootcamp",
                "DataBootCamp",
                "Diploma"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "imageVersion": {
            "type": "string",
            "defaultValue": "latest",
            "metadata": {
                "description": "Lab image version. The available versions are constrained by the UI definition, so this parameter deliberately has no allowedValues - adding one here means every monthly image release has to be edited in two files."
            }
        },
        "enableHotpatching": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Whether hotpatching is requested. Only applies to patchMode AutomaticByPlatform on supported images."
            }
        },
        "securityType": {
            "type": "string",
            "defaultValue": "Standard",
            "allowedValues": [
                "Standard",
                "TrustedLaunch"
            ],
            "metadata": {
                "description": "Standard or TrustedLaunch. Trusted Launch is currently unreachable because the vmSecurity UI section is hidden."
            }
        },
        "secureBoot": {
            "type": "bool",
            "defaultValue": false,
            "allowedValues": [
                true,
                false
            ],
            "metadata": {
                "description": "Enable to help protect the VM from malware e.g., root kits"
            }
        },
        "vTPM": {
            "type": "bool",
            "defaultValue": false,
            "allowedValues": [
                true,
                false
            ],
            "metadata": {
                "description": "Enable to configure a virtual Trusted Platform Module 2.0"
            }
        },
        "guestAttestation": {
            "type": "bool",
            "defaultValue": false,
            "allowedValues": [
                true,
                false
            ],
            "metadata": {
                "description": "Enable to configure a virtual Trusted Platform Module 2.0"
            }
        },
        "vnetNewOrExisting": {
            "type": "string",
            "defaultValue": "new",
            "allowedValues": [
                "new",
                "existing"
            ],
            "metadata": {
                "description": "Create a new or using an existing Virtual Network."
            }
        },
        "existingVnet": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Name of the existing virtual network. Empty when vnetNewOrExisting is new."
            }
        },
        "subnetName": {
            "type": "string",
            "defaultValue": "default",
            "metadata": {
                "description": "Subnet the network interfaces are attached to."
            }
        },
        "nicDeleteOption": {
            "type": "string",
            "defaultValue": "Delete",
            "allowedValues": [
                "Delete",
                "Detach"
            ],
            "metadata": {
                "description": "Whether the network interface is deleted or detached when the virtual machine is deleted."
            }
        },
        "pipDeleteOption": {
            "type": "string",
            "defaultValue": "Delete",
            "allowedValues": [
                "Delete",
                "Detach"
            ],
            "metadata": {
                "description": "Whether the public IP address is deleted or detached when the network interface is deleted."
            }
        },
        "createdBy": {
            "type": "string",
            "metadata": {
                "description": "Please enter your firstname and surname."
            }
        },
        "deliveringCoachInitials": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "metadata": {
                "description": "The first and last initial of the delivering coach. Exactly two characters, because the 15 character Windows host name budget depends on it."
            }
        },
        "deliveringCoachEmail": {
            "type": "string",
            "metadata": {
                "description": "Full email address of the delivering coach, for example joe.bloggs@balticapprenticeships.com. The portal asks only for the name part and appends @balticapprenticeships.com in ui.json, so a portal deployment always sends a whole address. A CLI deployment has to send the whole address itself - nothing here appends the domain, and a bare name would become a broken CoachEmail tag."
            }
        },
        "routeway": {
            "type": "string",
            "metadata": {
                "description": "Routeway delivering the training. Selects which Key Vault the lab credentials are read from, via the rwkeyVault map."
            }
        },
        "courseStartDate": {
            "type": "string",
            "metadata": {
                "description": "Please provide the start date of the course on the following format 01/01/2022."
            }
        },
        "courseEndDay": {
            "type": "string",
            "metadata": {
                "description": "Please enter the day of the week that the course will end e.g., Tuesday."
            }
        },
        "startupSchedule": {
            "type": "string",
            "defaultValue": "No",
            "allowedValues": [
                "Yes",
                "No"
            ],
            "metadata": {
                "description": "Should the virtual machines start automatically at the beginning of each day?"
            }
        },
        "idleHibernate": {
            "type": "string",
            "defaultValue": "Disabled",
            "allowedValues": [
                "Enabled",
                "Disabled"
            ],
            "metadata": {
                "description": "Enabled hibernates a virtual machine after a period of inactivity. It sets the IdleHibernate tag and installs the idle hibernation VM application on every machine. Defaults to Disabled."
            }
        },
        "idleHibernateAppName": {
            "type": "string",
            "defaultValue": "IdleHibernation",
            "metadata": {
                "description": "Name of the gallery application installed when idleHibernate is Enabled. The UI does not ask for it - it is not a coach decision. It has to live in the same gallery as the course images, because windowsVm.json composes the package id from the subscription id read from the routeway Key Vault. Set it to an empty string to install nothing."
            }
        },
        "idleHibernateAppVersion": {
            "type": "string",
            "defaultValue": "latest",
            "metadata": {
                "description": "Version of that gallery application. latest is not documented for application versions - see README.md - so pin a real version if it is rejected."
            }
        },
        "idleHibernateRoleDefinitionId": {
            "type": "string",
            "defaultValue": "a23c0eed-355e-417d-9759-144c48a84c68",
            "metadata": {
                "description": "GUID of the VM Idle Self Hibernate custom role, assigned to each machine's own system-assigned managed identity on the machine itself so it can hibernate when idle. The UI does not ask for it - it is not a coach decision. Set it to an empty string to build the machines with an identity but no role assignment, which is the fallback when the deploying principal has no rights to create role assignments."
            }
        },
        "rdpPublish": {
            "type": "string",
            "defaultValue": "No",
            "allowedValues": [
                "Yes",
                "No"
            ],
            "metadata": {
                "description": "Yes publishes RDP through the external RDP publishing automation, which reads the RdpPublish tag, and the virtual machines are built with no public IP address. No gives every virtual machine a public IP address with a DNS label so a coach can connect directly. Either way the network security group allows RDP from any address by design."
            }
        },
        "resourceGroupCleanup": {
            "type": "string",
            "defaultValue": "Enabled",
            "allowedValues": [
                "Enabled",
                "Disabled"
            ],
            "metadata": {
                "description": "Choose whether to have the virtual machine and associated resources deleted automatically at the end of the week."
            }
        },
        "_artifactsLocation": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/balticapprenticeships/azure",
            "metadata": {
                "description": "Base URI the linked module templates are fetched from. Override to deploy the modules from somewhere other than this GitHub repository."
            }
        },
        "_artifactsRef": {
            "type": "string",
            "defaultValue": "main",
            "metadata": {
                "description": "Git ref the linked module templates are fetched from - a branch, tag or commit SHA. Defaults to main. Pass a tag to pin a deployment to a released set of modules, or a branch name to test changes before merging."
            }
        },
        "l3DataCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "DataLevel3"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "l4DataCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "DataLevel4Sql",
                "DataLevel4"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "l5DataCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "DataLevel5"
            ],
            "metadata": {
                "description": "Choose the course to deliver"
            }
        },
        "l4SoftDevCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "SWAPC5",
                "SWAPC5UE5"
            ],
            "metadata": {
                "description": "Choose the course to devliver"
            }
        },
        "examCourse": {
            "type": "string",
            "defaultValue": "NoValue",
            "allowedValues": [
                "NoValue",
                "ExamTesting",
                "ExamImage"
            ],
            "metadata": {
                "description": "Choose the exam to proctor"
            }
        }
    },
    "functions": [],
    "variables": {
        "rwkeyVault": {
            "IT": {
                "keyVaultRg": "ITRouteway",
                "rwSuffix": "ITR"
            },
            "SoftwareDevelopment": {
                "keyVaultRg": "SWDRouteway",
                "rwSuffix": "SWD"
            },
            "Data": {
                "keyVaultRg": "DataRouteway",
                "rwSuffix": "Data"
            },
            "InternalDev": {
                "keyVaultRg": "IntDev",
                "rwSuffix": "IntDev"
            },
            "DigitalSkills": {
                "keyVaultRg": "DigitalSkills",
                "rwSuffix": "Digital"
            }
        },
        "patchMode": "[if(equals(parameters('osPlatform'), 'Windows'), if(equals(parameters('vmPlatform'), 'WindowsServer'), 'Manual', 'AutomaticByOS'), 'ImageDefault')]",
        "licenseType": "AzureLicense",
        "courseImageValue": {
            "l3IctSupTech": {
                "courseImageDefinitionName": "[parameters('l3SupTechCourse')]"
            },
            "l3IctNetTech": {
                "courseImageDefinitionName": "[parameters('l3NetTechCourse')]"
            },
            "l4NetEng": {
                "courseImageDefinitionName": "[parameters('l4NetEngCourse')]"
            },
            "bootcamp": {
                "courseImageDefinitionName": "[parameters('bootcampCourse')]"
            },
            "l3Data": {
                "courseImageDefinitionName": "[parameters('l3DataCourse')]"
            },
            "l4Data": {
                "courseImageDefinitionName": "[parameters('l4DataCourse')]"
            },
            "l5Data": {
                "courseImageDefinitionName": "[parameters('l5DataCourse')]"
            },
            "l4SoftDev": {
                "courseImageDefinitionName": "[parameters('l4SoftDevCourse')]"
            },
            "exams": {
                "courseImageDefinitionName": "[parameters('examCourse')]"
            }
        },
        "vaultResourceGroup": "[concat(variables('rwkeyVault')[parameters('routeway')].keyVaultRg, 'OMSRg')]",
        "vaultName": "[concat('VMDeployment', variables('rwkeyVault')[parameters('routeway')].rwSuffix)]",
        "deploymentsApi": "2025-04-01",
        "deployPublicIp": "[equals(parameters('rdpPublish'), 'No')]",
        "_moduleRepo": "[concat('/', parameters('_artifactsRef'), '/deployment/vmdeployment-single/modules')]"
    },
    "resources": [
        {
            "name": "DeployNetworkSecurityGroup",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "[variables('deploymentsApi')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), variables('_moduleRepo'), '/networkSecurityGroup.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "location": {
                        "value": "[parameters('location')]"
                    },
                    "osPlatform": {
                        "value": "[parameters('osPlatform')]"
                    },
                    "createdBy": {
                        "value": "[parameters('createdBy')]"
                    },
                    "courseStartDate": {
                        "value": "[parameters('courseStartDate')]"
                    },
                    "resourceGroupCleanup": {
                        "value": "[parameters('resourceGroupCleanup')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "condition": "[equals(parameters('vnetNewOrExisting'), 'new')]",
            "name": "DeployVirtualNetwork",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "[variables('deploymentsApi')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), variables('_moduleRepo'), '/virtualNetwork.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "location": {
                        "value": "[parameters('location')]"
                    },
                    "subnetName": {
                        "value": "[parameters('subnetName')]"
                    },
                    "createdBy": {
                        "value": "[parameters('createdBy')]"
                    },
                    "courseStartDate": {
                        "value": "[parameters('courseStartDate')]"
                    },
                    "resourceGroupCleanup": {
                        "value": "[parameters('resourceGroupCleanup')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "condition": "[variables('deployPublicIp')]",
            "name": "DeployPublicIPAddress",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "[variables('deploymentsApi')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), variables('_moduleRepo'), '/publicIP.json')]",
                    "contentVersion": "1.1.0.0"
                },
                "parameters": {
                    "location": {
                        "value": "[parameters('location')]"
                    },
                    "vmName": {
                        "value": "[parameters('vmName')]"
                    },
                    "vmCount": {
                        "value": "[parameters('vmCount')]"
                    },
                    "createdBy": {
                        "value": "[parameters('createdBy')]"
                    },
                    "deliveringCoachInitials": {
                        "value": "[parameters('deliveringCoachInitials')]"
                    },
                    "courseStartDate": {
                        "value": "[parameters('courseStartDate')]"
                    },
                    "resourceGroupCleanup": {
                        "value": "[parameters('resourceGroupCleanup')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "DeployNetworkInterface",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "[variables('deploymentsApi')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), variables('_moduleRepo'), '/networkInterface.json')]",
                    "contentVersion": "1.2.0.0"
                },
                "parameters": {
                    "location": {
                        "value": "[parameters('location')]"
                    },
                    "vmName": {
                        "value": "[parameters('vmName')]"
                    },
                    "vmCount": {
                        "value": "[parameters('vmCount')]"
                    },
                    "vmSize": {
                        "value": "[parameters('vmSize')]"
                    },
                    "vnetNewOrExisting": {
                        "value": "[parameters('vnetNewOrExisting')]"
                    },
                    "pipDeleteOption": {
                        "value": "[parameters('pipDeleteOption')]"
                    },
                    "publicIpEnabled": {
                        "value": "[variables('deployPublicIp')]"
                    },
                    "existingVnet": {
                        "value": "[parameters('existingVnet')]"
                    },
                    "subnetName": {
                        "value": "[parameters('subnetName')]"
                    },
                    "createdBy": {
                        "value": "[parameters('createdBy')]"
                    },
                    "deliveringCoachInitials": {
                        "value": "[parameters('deliveringCoachInitials')]"
                    },
                    "courseStartDate": {
                        "value": "[parameters('courseStartDate')]"
                    },
                    "resourceGroupCleanup": {
                        "value": "[parameters('resourceGroupCleanup')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'DeployNetworkSecurityGroup')]",
                "[resourceId('Microsoft.Resources/deployments', 'DeployVirtualNetwork')]",
                "[resourceId('Microsoft.Resources/deployments', 'DeployPublicIPAddress')]"
            ]
        },
        {
            "name": "DeployVm",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "[variables('deploymentsApi')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), variables('_moduleRepo'), '/windowsVm.json')]",
                    "contentVersion": "1.8.0.0"
                },
                "parameters": {
                    "vmPlatform": {
                        "value": "[parameters('vmPlatform')]"
                    },
                    "hibernationEnabled": {
                        "value": "[parameters('hibernationEnabled')]"
                    },
                    "location": {
                        "value": "[parameters('location')]"
                    },
                    "subscriptionId": {
                        "reference": {
                            "keyVault": {
                                "id": "[resourceId(variables('vaultResourceGroup'), 'Microsoft.KeyVault/vaults', variables('vaultName'))]"
                            },
                            "secretName": "SubscriptionId"
                        }
                    },
                    "vmName": {
                        "value": "[parameters('vmName')]"
                    },
                    "vmSize": {
                        "value": "[parameters('vmSize')]"
                    },
                    "vmCount": {
                        "value": "[parameters('vmCount')]"
                    },
                    "osDiskType": {
                        "value": "[parameters('osDiskType')]"
                    },
                    "osDiskDeleteOption": {
                        "value": "[parameters('osDiskDeleteOption')]"
                    },
                    "course": {
                        "value": "[variables('courseImageValue')[parameters('apprenticeshipProgramme')].courseImageDefinitionName]"
                    },
                    "imageVersion": {
                        "value": "[parameters('imageVersion')]"
                    },
                    "licenseType": {
                        "value": "[variables('licenseType')]"
                    },
                    "enableHotpatching": {
                        "value": "[parameters('enableHotpatching')]"
                    },
                    "patchMode": {
                        "value": "[variables('patchMode')]"
                    },
                    "securityType": {
                        "value": "[parameters('securityType')]"
                    },
                    "secureBoot": {
                        "value": "[parameters('secureBoot')]"
                    },
                    "vTPM": {
                        "value": "[parameters('vTPM')]"
                    },
                    "guestAttestation": {
                        "value": "[parameters('guestAttestation')]"
                    },
                    "idleHibernate": {
                        "value": "[parameters('idleHibernate')]"
                    },
                    "idleHibernateAppName": {
                        "value": "[parameters('idleHibernateAppName')]"
                    },
                    "idleHibernateAppVersion": {
                        "value": "[parameters('idleHibernateAppVersion')]"
                    },
                    "idleHibernateRoleDefinitionId": {
                        "value": "[parameters('idleHibernateRoleDefinitionId')]"
                    },
                    "nicDeleteOption": {
                        "value": "[parameters('nicDeleteOption')]"
                    },
                    "adminUsername": {
                        "reference": {
                            "keyVault": {
                                "id": "[resourceId(variables('vaultResourceGroup'), 'Microsoft.KeyVault/vaults', variables('vaultName'))]"
                            },
                            "secretName": "LabAdmin"
                        }
                    },
                    "adminPassword": {
                        "reference": {
                            "keyVault": {
                                "id": "[resourceId(variables('vaultResourceGroup'), 'Microsoft.KeyVault/vaults', variables('vaultName'))]"
                            },
                            "secretName": "LabAdminPassword"
                        }
                    },
                    "localUsername": {
                        "reference": {
                            "keyVault": {
                                "id": "[resourceId(variables('vaultResourceGroup'), 'Microsoft.KeyVault/vaults', variables('vaultName'))]"
                            },
                            "secretName": "LabUser"
                        }
                    },
                    "localUserPassword": {
                        "reference": {
                            "keyVault": {
                                "id": "[resourceId(variables('vaultResourceGroup'), 'Microsoft.KeyVault/vaults', variables('vaultName'))]"
                            },
                            "secretName": "LabUserPassword"
                        }
                    },
                    "createdBy": {
                        "value": "[parameters('createdBy')]"
                    },
                    "deliveringCoachInitials": {
                        "value": "[parameters('deliveringCoachInitials')]"
                    },
                    "deliveringCoachEmail": {
                        "value": "[parameters('deliveringCoachEmail')]"
                    },
                    "courseStartDate": {
                        "value": "[parameters('courseStartDate')]"
                    },
                    "courseEndDay": {
                        "value": "[parameters('courseEndDay')]"
                    },
                    "startupSchedule": {
                        "value": "[parameters('startupSchedule')]"
                    },
                    "rdpPublish": {
                        "value": "[parameters('rdpPublish')]"
                    },
                    "resourceGroupCleanup": {
                        "value": "[parameters('resourceGroupCleanup')]"
                    },
                    "postgresPassword": {
                        "reference": {
                            "keyVault": {
                                "id": "[resourceId(variables('vaultResourceGroup'), 'Microsoft.KeyVault/vaults', variables('vaultName'))]"
                            },
                            "secretName": "PostgresAdminPassword"
                        }
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'DeployNetworkInterface')]"
            ]
        },
        {
            "name": "DeployShutdownSchedule",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "[variables('deploymentsApi')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), variables('_moduleRepo'), '/shutdownSchedule.json')]",
                    "contentVersion": "1.1.0.0"
                },
                "parameters": {
                    "location": {
                        "value": "[parameters('location')]"
                    },
                    "vmName": {
                        "value": "[parameters('vmName')]"
                    },
                    "vmCount": {
                        "value": "[parameters('vmCount')]"
                    },
                    "deliveringCoachInitials": {
                        "value": "[parameters('deliveringCoachInitials')]"
                    },
                    "createdBy": {
                        "value": "[parameters('createdBy')]"
                    },
                    "courseStartDate": {
                        "value": "[parameters('courseStartDate')]"
                    },
                    "courseEndDay": {
                        "value": "[parameters('courseEndDay')]"
                    },
                    "resourceGroupCleanup": {
                        "value": "[parameters('resourceGroupCleanup')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'DeployVm')]"
            ]
        }
    ],
    "outputs": {
        "contentVersion": {
            "type": "string",
            "value": "[deployment().properties.template.contentVersion]"
        },
        "location": {
            "type": "string",
            "value": "[parameters('location')]"
        },
        "vmPlatform": {
            "type": "string",
            "value": "[parameters('vmPlatform')]"
        },
        "vmNamePrefix": {
            "type": "string",
            "value": "[parameters('vmName')]"
        },
        "createdBy": {
            "type": "string",
            "value": "[parameters('createdBy')]"
        },
        "coach": {
            "type": "string",
            "value": "[parameters('deliveringCoachInitials')]"
        },
        "scheduleOn": {
            "type": "string",
            "value": "[parameters('startupSchedule')]"
        },
        "idleHibernate": {
            "type": "string",
            "value": "[parameters('idleHibernate')]"
        },
        "resourceGroupCleanup": {
            "type": "string",
            "value": "[parameters('resourceGroupCleanup')]"
        },
        "osDiskType": {
            "type": "string",
            "value": "[parameters('osDisktype')]"
        },
        "vmSize": {
            "type": "string",
            "value": "[parameters('vmSize')]"
        },
        "osPlatform": {
            "type": "string",
            "value": "[parameters('osPlatform')]"
        },
        "apprenticeshipProgramme": {
            "type": "string",
            "value": "[parameters('apprenticeshipProgramme')]"
        },
        "courseImage": {
            "type": "string",
            "value": "[variables('courseImageValue')[parameters('apprenticeshipProgramme')].courseImageDefinitionName]"
        },
        "imageVersion": {
            "type": "string",
            "value": "[parameters('imageVersion')]"
        },
        "vmPrincipalId": {
            "type": "array",
            "value": "[reference('DeployVm').outputs.vmPrincipalId.value]"
        },
        "virtualMachineFQDN": {
            "condition": "[variables('deployPublicIp')]",
            "type": "array",
            "value": "[reference('DeployPublicIPAddress').outputs.FQDN.value]"
        }
    }
}
