{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "type": "string",
            "metadata": {
                "description": "Azure region the resources are created in. Comes from the resource group on the Basics tab."
            }
        },
        "subnetName": {
            "type": "string",
            "metadata": {
                "description": "Subnet the network interfaces are attached to."
            }
        },
        "createdBy": {
            "type": "string",
            "metadata": {
                "description": "Coach full name, used for the CreatedBy tag on every resource."
            }
        },
        "courseStartDate": {
            "type": "string",
            "metadata": {
                "description": "Course start date as dd/mm/yyyy. Becomes the CourseDate tag, prefixed with WC-."
            }
        },
        "resourceGroupCleanup": {
            "type": "string",
            "metadata": {
                "description": "Enabled or Disabled. Becomes the Cleanup tag that the weekly cleanup runbook reads."
            }
        }
    },
    "functions": [],
    "variables": {
        "networkApi": "2024-07-01",
        "vnetName": "[concat(resourceGroup().name, '-vnet')]",
        "addressPrefixes": "10.0.0.0/16",
        "subnetsAddressPrefix": "10.0.0.0/24"
    },
    "resources": [
        {
            "name": "[variables('vnetName')]",
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "[variables('networkApi')]",
            "location": "[parameters('location')]",
            "tags": {
                "DisplayName": "Virtual Network",
                "ResourceType": "VirtualNetwork",
                "Dept": "[if(contains(resourceGroup().tags, 'Dept'), resourceGroup().tags['Dept'], 'Unknown')]",
                "CreatedBy": "[parameters('createdBy')]",
                "CourseDate": "[concat('WC-', parameters('courseStartDate'))]",
                "Cleanup": "[parameters('resourceGroupCleanup')]"
            },
            "properties": {
                "addressSpace": {
                    "addressPrefixes": [
                        "[variables('addressPrefixes')]"
                    ]
                },
                "subnets": [
                    {
                        "name": "[parameters('subnetName')]",
                        "properties": {
                            "addressPrefix": "[variables('subnetsAddressPrefix')]"
                        }
                    }
                ]
            }
        }
    ],
    "outputs": {
        "vnetId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        },
        "vnetName": {
            "type": "string",
            "value": "[variables('vnetName')]"
        }
    }
}
